local function UpdateInventory()
    ClearInventoryRows()

    local Backpack = Player:FindFirstChildOfClass("Backpack")
    local Character = Player.Character

    local FoundTools = {}
    local TotalTools = 0
    local Search = string.lower(InventorySearch.Text or "")

    local function AddTools(Container, Equipped)
        if not Container then
            return
        end

        for _, Object in ipairs(Container:GetChildren()) do
            if Object:IsA("Tool") and not FoundTools[Object] then
                FoundTools[Object] = true
                TotalTools = TotalTools + 1

                if Search == ""
                    or string.find(
                        string.lower(Object.Name),
                        Search,
                        1,
                        true
                    ) then

                    CreateInventoryRow(Object, Equipped)
                end
            end
        end
    end

    AddTools(Backpack, false)
    AddTools(Character, true)

    InventoryCount.Text = tostring(TotalTools) .. " ITEMS"

    InventoryEmpty.Visible = #InventoryRows == 0

    if TotalTools == 0 then
        InventoryEmpty.Text = "NO TOOLS DETECTED"
    elseif #InventoryRows == 0 then
        InventoryEmpty.Text = "NO MATCHING TOOLS"
    end
end

local function QueueInventoryRefresh()
    if InventoryRefreshQueued then
        return
    end

    InventoryRefreshQueued = true

    task.defer(function()
        InventoryRefreshQueued = false

        if InventoryCard and InventoryCard.Parent then
            UpdateInventory()
        end
    end)
end

local function DisconnectInventoryConnections()
    for _, Connection in ipairs(InventoryConnections) do
        if Connection then
            Connection:Disconnect()
        end
    end

    table.clear(InventoryConnections)
end

local function WatchInventoryContainer(Container)
    if not Container then
        return
    end

    table.insert(
        InventoryConnections,
        Container.ChildAdded:Connect(QueueInventoryRefresh)
    )

    table.insert(
        InventoryConnections,
        Container.ChildRemoved:Connect(QueueInventoryRefresh)
    )
end

local function BindInventoryContainers()
    DisconnectInventoryConnections()

    local Backpack = Player:FindFirstChildOfClass("Backpack")
    local Character = Player.Character

    WatchInventoryContainer(Backpack)
    WatchInventoryContainer(Character)

    QueueInventoryRefresh()
end

