-- AVATAR TOUCH / MOUSE ROTATION
--==================================================

AvatarViewport.Active = true

AvatarViewport.InputBegan:Connect(function(Input)
    if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then

        AvatarDragging = true
        AvatarDragInput = Input
        AvatarLastX = Input.Position.X
    end
end)

UIS.InputChanged:Connect(function(Input)
    if not AvatarDragging or not AvatarModel then
        return
    end

    local IsMouseMove =
        Input.UserInputType == Enum.UserInputType.MouseMovement

    local IsTouchMove =
        Input.UserInputType == Enum.UserInputType.Touch
        and Input == AvatarDragInput

    if IsMouseMove or IsTouchMove then
        local Delta = Input.Position.X - AvatarLastX
        AvatarLastX = Input.Position.X

        AvatarAngle = AvatarAngle + Delta * 0.012

        AvatarModel:PivotTo(
            CFrame.new(0, 0, 0)
            * CFrame.Angles(0, AvatarAngle, 0)
        )
    end
end)

UIS.InputEnded:Connect(function(Input)
    if Input == AvatarDragInput
        or Input.UserInputType == Enum.UserInputType.MouseButton1 then

        AvatarDragging = false
        AvatarDragInput = nil
    end
end)

