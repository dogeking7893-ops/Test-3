--==================================================
-- AVATAR PREVIEW ENGINE
--==================================================

local AvatarModel = nil
local AvatarAngle = 0
local AvatarDragging = false
local AvatarDragInput = nil
local AvatarLastX = 0

local function PrepareAvatarModel(Model)
    if not Model then
        return false
    end

    -- Remove scripts from the preview clone only.
    for _, Object in ipairs(Model:GetDescendants()) do
        if Object:IsA("Script")
            or Object:IsA("LocalScript")
            or Object:IsA("ModuleScript") then

            Object:Destroy()

        elseif Object:IsA("BasePart") then
            Object.Anchored = true
            Object.CanCollide = false
            Object.CanTouch = false
            Object.CanQuery = false
        end
    end

    local Root = Model:FindFirstChild("HumanoidRootPart")

    if Root then
        Model.PrimaryPart = Root
    end

    local Humanoid = Model:FindFirstChildOfClass("Humanoid")

    if Humanoid then
        Humanoid.DisplayDistanceType =
            Enum.HumanoidDisplayDistanceType.None
    end

    Model.Parent = AvatarWorld

    -- Calculate model framing.
    local BoundingCFrame, BoundingSize = Model:GetBoundingBox()
    local Center = BoundingCFrame.Position

    local Height = math.max(BoundingSize.Y, 3)
    local Width = math.max(BoundingSize.X, 2)

    local Distance = math.max(
        Height * 1.35,
        Width * 2.4,
        5
    )

    AvatarCamera.FieldOfView = 35

    AvatarCamera.CFrame = CFrame.lookAt(
        Center + Vector3.new(0, Height * 0.05, Distance),
        Center + Vector3.new(0, Height * 0.05, 0)
    )

    AvatarModel = Model
    AvatarAngle = 0

    return true
end

local function BuildAvatarPreview()
    if AvatarModel then
        AvatarModel:Destroy()
        AvatarModel = nil
    end

    for _, Object in ipairs(AvatarWorld:GetChildren()) do
        Object:Destroy()
    end

    local Character = Player.Character

    if not Character then
        AvatarState.Text = "● WAITING FOR CHARACTER"
        AvatarState.TextColor3 = StatusColors.Muted
        return
    end

    local OldArchivable = Character.Archivable
    local Clone

    -- Temporarily allow cloning, then restore the original setting.
    local Success = pcall(function()
        Character.Archivable = true
        Clone = Character:Clone()
    end)

    pcall(function()
        Character.Archivable = OldArchivable
    end)

    if not Success or not Clone then
        AvatarState.Text = "● PREVIEW UNAVAILABLE"
        AvatarState.TextColor3 = StatusColors.Red
        return
    end

    local Prepared = pcall(function()
        PrepareAvatarModel(Clone)
    end)

    if not Prepared then
        Clone:Destroy()
        AvatarModel = nil
        AvatarState.Text = "● PREVIEW ERROR"
        AvatarState.TextColor3 = StatusColors.Red
        return
    end

    AvatarState.Text = "● PLAYER ACTIVE"
    AvatarState.TextColor3 = StatusColors.Green
end

