local function ConnectCharacter(
    Character,
    IsRespawn
)
    DisconnectCharacter()

    CurrentHumanoid =
        Character:FindFirstChildOfClass("Humanoid")

    CurrentRoot =
        Character:FindFirstChild("HumanoidRootPart")

    if CurrentHumanoid then
        CaptureDefaults(CurrentHumanoid)

        if not IsRespawn then
            CurrentWalkSpeed =
                DefaultWalkSpeed

            CurrentJumpPower =
                DefaultJumpPower
        end

        UpdateSpeedVisual()
        UpdateJumpVisual()
        ApplyMovement()
    end

    if IsRespawn then
        RespawnCount += 1

        RespawnLabel.Text =
            "RESPAWNS: "
            .. tostring(RespawnCount)

        RespawnStatsLabel.Text =
            "RESPAWNS: "
            .. tostring(RespawnCount)

        Notify(
            "CHARACTER RESPAWN DETECTED",
            StatusColors.Cyan
        )

        task.delay(2,function()
            if NotificationText.Parent then
                Notify(
                    "SYSTEM MONITORING ACTIVE",
                    StatusColors.Muted
                )
            end
        end)
    end

    if CurrentHumanoid then
        LastHealth =
            CurrentHumanoid.Health

        table.insert(
            CharacterConnections,
            CurrentHumanoid.HealthChanged:Connect(
                function(Health)

                    if LastHealth then
                        local Difference =
                            math.abs(
                                Health-LastHealth
                            )

                        if Difference>=20 then
                            Notify(
                                "HEALTH CHANGE DETECTED: "
                                .. tostring(
                                    math.floor(
                                        Health+.5
                                    )
                                ),
                                Health>LastHealth
                                    and StatusColors.Green
                                    or StatusColors.Cyan
                            )
                        end
                    end

                    LastHealth = Health
                end
            )
        )

        table.insert(
            CharacterConnections,
            CurrentHumanoid.Died:Connect(
                function()

                    AliveLabel.Text =
                        "STATE: DEAD"

                    AliveLabel.TextColor3 =
                        StatusColors.Red

