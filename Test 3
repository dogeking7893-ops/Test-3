            AliveLabel.Text =
                "STATE: WAITING"

            AliveLabel.TextColor3 =
                StatusColors.Muted

            PositionLabel.Text =
                "POSITION: --"
        end

        -- FPS
        local FPSColor =
            PerformanceColor(
                CurrentFPS,
                "FPS"
            )

        FPSLabel.Text =
            "FPS: "
            .. tostring(CurrentFPS)

        FPSLabel.TextColor3 =
            FPSColor

        AddGraphPoint(
            FPSGraph,
            FPSHistory,
            CurrentFPS,
            0,
            120
        )

        -- Ping
        local Ping = GetPing()

        if Ping then
            local P =
                math.floor(Ping+.5)

            PingLabel.Text =
                "PING: "
                .. tostring(P)
                .. " ms"

            PingLabel.TextColor3 =
                PerformanceColor(
                    P,
                    "Ping"
                )

            AddGraphPoint(
                PingGraph,
                PingHistory,
                P,
                0,
                300
            )

            if P>200
            and CurrentFPS>=5
            and CurrentFPS<=10 then

                PerformanceState.Text =
                    "WARNING"

                PerformanceState.TextColor3 =
                    StatusColors.Red

                NetworkWarning(
                    P,
                    CurrentFPS
                )

            elseif P>200 then

                PerformanceState.Text =
                    "HIGH PING"

                PerformanceState.TextColor3 =
                    StatusColors.Red

            elseif CurrentFPS<=10 then

                PerformanceState.Text =
                    "LOW FPS"

                PerformanceState.TextColor3 =
                    StatusColors.Red

            elseif P>120
            or CurrentFPS<30 then

                PerformanceState.Text =
                    "ELEVATED"

                PerformanceState.TextColor3 =
                    StatusColors.Cyan

            else

                PerformanceState.Text =
                    "STABLE"

                PerformanceState.TextColor3 =
                    StatusColors.Green
            end

            if P<180 then
                LastPingWarning = false
            end
        else
            PingLabel.Text =
                "PING: -- ms"

            PingLabel.TextColor3 =
                StatusColors.Muted

            PerformanceState.Text =
                "PING UNAVAILABLE"

            PerformanceState.TextColor3 =
                StatusColors.Muted
        end
    end
)

