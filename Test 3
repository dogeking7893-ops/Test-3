            AnchorPoint=Vector2.new(.5,.5),
            Position=UDim2.new(X,0,Y,0),
            BackgroundColor3=StatusColors.Cyan,
            BorderSizePixel=0
        },Graph)

        StatusCorner(Point,3)
    end
end

