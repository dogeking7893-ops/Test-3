local WALK_MIN,WALK_MAX = 8,40
local JUMP_MIN,JUMP_MAX = 20,100

local DefaultWalkSpeed = 16
local DefaultJumpPower = 50
local CurrentWalkSpeed = 16
local CurrentJumpPower = 50

local SpeedDragging = false
local JumpDragging = false

local function GetHumanoid()
    local Character = Player.Character
    return Character and Character:FindFirstChildOfClass("Humanoid")
end

local function CaptureDefaults(Humanoid)
    if not Humanoid then return end

    DefaultWalkSpeed = Humanoid.WalkSpeed > 0
        and Humanoid.WalkSpeed or 16

    DefaultJumpPower = Humanoid.UseJumpPower
        and (Humanoid.JumpPower > 0 and Humanoid.JumpPower or 50)
        or 50
end

local function ApplyMovement()
    local Humanoid = GetHumanoid()

    if not Humanoid then
        MovementState.Text = "WAITING"
        MovementState.TextColor3 = StatusColors.Muted
        return
    end

    Humanoid.WalkSpeed = CurrentWalkSpeed

    if Humanoid.UseJumpPower then
        Humanoid.JumpPower = CurrentJumpPower
    end

    MovementState.Text = "LIVE"
    MovementState.TextColor3 = StatusColors.Green
end

local function UpdateSpeedVisual()
    local A = math.clamp(
        (CurrentWalkSpeed-WALK_MIN)/(WALK_MAX-WALK_MIN),
        0,1
    )

    SpeedFill.Size = UDim2.new(A,0,1,0)
    SpeedKnob.Position = UDim2.new(A,0,.5,0)
    SpeedValue.Text = tostring(
        math.floor(CurrentWalkSpeed+.5)
    )
end

local function UpdateJumpVisual()
    local A = math.clamp(
        (CurrentJumpPower-JUMP_MIN)/(JUMP_MAX-JUMP_MIN),
        0,1
    )

    JumpFill.Size = UDim2.new(A,0,1,0)
    JumpKnob.Position = UDim2.new(A,0,.5,0)
    JumpValue.Text = tostring(
        math.floor(CurrentJumpPower+.5)
    )
end

local function SetSpeed(V)
    CurrentWalkSpeed = math.clamp(
        math.floor(V+.5),
        WALK_MIN,WALK_MAX
    )
    UpdateSpeedVisual()
    ApplyMovement()
end

local function SetJump(V)
    CurrentJumpPower = math.clamp(
        math.floor(V+.5),
        JUMP_MIN,JUMP_MAX
    )
    UpdateJumpVisual()
    ApplyMovement()
end

local function SpeedInput(Input)
    local W = SpeedTrack.AbsoluteSize.X
    if W <= 0 then return end

    local A = math.clamp(
        (Input.Position.X-SpeedTrack.AbsolutePosition.X)/W,
        0,1
    )

    SetSpeed(
        WALK_MIN+(WALK_MAX-WALK_MIN)*A
    )
end

local function JumpInput(Input)
    local W = JumpTrack.AbsoluteSize.X
    if W <= 0 then return end

    local A = math.clamp(
        (Input.Position.X-JumpTrack.AbsolutePosition.X)/W,
        0,1
    )

    SetJump(
        JUMP_MIN+(JUMP_MAX-JUMP_MIN)*A
    )
end

