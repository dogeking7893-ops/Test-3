--==================================================
-- CREATE HELPER FIX
-- Allows Parent inside properties tables
--==================================================

Create = function(class, props, parent)
    local obj = Instance.new(class)
    local finalParent = parent

    for key, value in pairs(props or {}) do
        if key == "Parent" then
            finalParent = value
        else
            obj[key] = value
        end
    end

    obj.Parent = finalParent
    return obj
end

