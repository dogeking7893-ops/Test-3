local function AddGraphPoint(
    Graph,History,Value,Min,Max
)
    table.insert(History,Value)

    while #History > MAX_GRAPH_POINTS do
        table.remove(History,1)
    end

    for _,Child in ipairs(Graph:GetChildren()) do
        if Child:IsA("Frame")
        and Child.Name=="GraphPoint" then
            Child:Destroy()
        end
    end

    for I,Number in ipairs(History) do
        local X = #History <= 1
            and 0
            or (I-1)/(#History-1)

        local Y = 1-math.clamp(
            (Number-Min)/math.max(1,Max-Min),
            0,1
        )

        local Point = StatusCreate("Frame",{
            Name="GraphPoint",
